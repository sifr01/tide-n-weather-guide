# .env
# Yhis is how your .env file should look
# You will need to rename it in order for it to become useable by the app and then add your own API key

API_KEY = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa-aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"

# Set to "true" to use local mock JSON files (model/*.json) instead of calling
# the Stormglass API. Set to "false" (or remove) for live API calls.
USE_MOCK_DATA = "true"
